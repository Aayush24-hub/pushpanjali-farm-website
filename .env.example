# Postgres connection string (Neon, Supabase, Vercel Postgres, etc.)
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Vercel Blob read/write token (Vercel dashboard -> Storage -> Blob -> your store)
BLOB_READ_WRITE_TOKEN=

# Public URL of the site, no trailing slash. Needed for login on custom domains.
BETTER_AUTH_URL=https://your-domain.example

# Long random string used to sign sessions: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
